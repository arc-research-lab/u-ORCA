        throw std::runtime_error("INT4 logical element count must be even");
    }
    std::vector<int8> packed(logical.size() / 2);
    for (size_t i = 0; i < packed.size(); ++i) {
        const uint8_t even = static_cast<uint8_t>(logical[2 * i]) & 0xf;
        const uint8_t odd = static_cast<uint8_t>(logical[2 * i + 1]) & 0xf;
        packed[i] = static_cast<int8>((odd << 4) | even);
    }
    return packed;
}
