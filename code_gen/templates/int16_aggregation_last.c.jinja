        int16* pA01 = pA + (j + 1) * blk_size;
        int16* pA11 = pA + (bound_j + j + 1) * blk_size;
        auto activation00 = aie::load_v<MMUL::size_B>(pA00);
        auto activation10 = aie::load_v<MMUL::size_B>(pA10);
        auto activation01 = aie::load_v<MMUL::size_B>(pA01);
        auto activation11 = aie::load_v<MMUL::size_B>(pA11);
        MMUL accumulator0(get_scd_v16acc64());
        accumulator0.mac(weights, activation00);
        accumulator0.mac(weights, activation10);
        MMUL accumulator1(get_scd_v16acc64());
        accumulator1.mac(weights, activation01);
        accumulator1.mac(weights, activation11);
