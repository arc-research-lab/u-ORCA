    output_cascade<acc64>* __restrict cascade_o) {
    aie::set_saturation(aie::saturation_mode::saturate);
    aie::set_rounding(aie::rounding_mode::symmetric_inf);
    int16* __restrict pA = input_act.data();
    using MMUL = aie::mmul<blk_M, blk_N, blk_N, int16, int16, acc64>;
    static_assert(std::is_same_v<typename MMUL::accum_type::value_type, acc64>);
